# Excel database path
EXCEL_PATH=./data/properties.xlsx

# User agent for HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Per-scraper timeout in milliseconds. If a scraper exceeds this duration it is
# aborted and the pipeline moves on to the next scraper, logging an error.
# Default: 300000 (5 minutes).
SCRAPER_TIMEOUT_MS=300000

# Active scrapers (comma-separated). Empty = run ALL scrapers.
# Available: onefix,bidleiloeira,lcpremium,leilosoc,avaliberica,leilostar,inlex,vleiloes,leiloeiradolena
ACTIVE_SCRAPERS=

# Filter properties by location. Set to "true" to enable location-based filtering.
# Default: false (bring all properties) for testing purposes.
FILTER_BY_LOCATION=false

# Districts to scope the "Zonas de Interesse" filter (comma-separated).
# Properties in other districts are excluded from the zone filter.
# Empty = no district restriction (exact name matching only).
ZONE_DISTRICTS=Aveiro,Porto